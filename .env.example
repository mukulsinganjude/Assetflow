ASSETFLOW_STORAGE=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SECRET_KEY

# On a brand-new install only, these create the first administrator account.
# Use a unique company email and a unique password (12-72 characters).
ASSETFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@ccrn.com
ASSETFLOW_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD
ASSETFLOW_BOOTSTRAP_ADMIN_NAME=AssetFlow Administrator

# Optional: comma-separated browser origins when using a custom front-end domain.
# The production Netlify site and private/local development origins are allowed by default.
# ASSETFLOW_CORS_ORIGINS=https://your-custom-site.example
